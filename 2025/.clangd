CompileFlags:
  # Let clangd detect include paths from compile_commands.json
  CompilationDatabase: build

  Add:
    # Project-wide include directory (for dial.h)
    - "-I${PROJECT_ROOT}/*/include"

    # Enable useful warnings
    - -Wall
    - -Wextra
    - -Wpedantic
    - -std=c++20

Index:
  # Index everything, including headers not yet included
  Background: true

Suggestions:
  # Better completion
  IncludeInsertion: true

Diagnostics:
  UnusedIncludes: Strict
